{
  "name": "readyvibe",
  "private": true,
  "version": "0.1.0",
  "description": "Launch-readiness skills and the deterministic engine behind them.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r --filter @readyvibe/schemas --filter @readyvibe/engine --filter @readyvibe/cli run build",
    "typecheck": "pnpm -r --filter @readyvibe/schemas --filter @readyvibe/engine --filter @readyvibe/cli --filter @readyvibe/skill-lint run typecheck",
    "test": "pnpm -r --filter @readyvibe/schemas --filter @readyvibe/engine --filter @readyvibe/cli --filter @readyvibe/skill-lint run test",
    "skill-lint": "pnpm --filter @readyvibe/skill-lint start -- ..",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}

{
  "name": "@readyvibe/engine",
  "version": "0.1.0",
  "description": "Deterministic launch-readiness engine. The engine assigns statuses; skills do not.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./probes": { "types": "./dist/probes/index.d.ts", "import": "./dist/probes/index.js" },
    "./report": { "types": "./dist/report/index.d.ts", "import": "./dist/report/index.js" },
    "./adapters": { "types": "./dist/adapters/index.d.ts", "import": "./dist/adapters/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@readyvibe/schemas": "workspace:*",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
